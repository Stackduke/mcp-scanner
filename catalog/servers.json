{
  "version": 1,
  "servers": [
    {
      "id": "github",
      "name": "GitHub",
      "url": "https://api.githubcopilot.com/mcp/",
      "site": "https://github.com",
      "signIn": "oauth-app",
      "signInCheckedOn": "2026-10-17",
      "termsCheckedOn": "2026-10-16",
      "tracker": {
        "publish": true,
        "access": {
          "kind": "api-key",
          "tokenVariable": "STACKDUKE_SCAN_GITHUB_TOKEN",
          "formerVariable": "AETHIS_SCAN_GITHUB_TOKEN",
          "keyPage": "https://github.com/settings/personal-access-tokens/new",
          "keyAdvice": "A fine-grained token with read-only access to public repositories and no other permissions."
        }
      }
    },
    {
      "id": "linear",
      "name": "Linear",
      "url": "https://mcp.linear.app/mcp",
      "site": "https://linear.app",
      "signIn": "oauth-metadata-doc",
      "signInCheckedOn": "2026-10-17",
      "termsCheckedOn": "2026-10-16",
      "tracker": {
        "publish": true,
        "access": {
          "kind": "api-key",
          "tokenVariable": "STACKDUKE_SCAN_LINEAR_TOKEN",
          "keyPage": "https://linear.app/settings/account/security",
          "keyAdvice": "A personal API key with Read only, in a workspace that holds nothing."
        }
      }
    },
    {
      "id": "stripe",
      "name": "Stripe",
      "url": "https://mcp.stripe.com/",
      "site": "https://stripe.com",

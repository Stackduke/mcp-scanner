#!/usr/bin/env bash
# Daily look at GitHub's hosted MCP server, for the Aethis tool-change tracker.
# Lists the server's tools with the `gh` login already on this machine, saves a
# snapshot, and logs how it compares with the one before. It never calls a tool.
# The login is read when this runs and handed to the scanner in its environment;
# it is not written here, to the log, or to a snapshot.
# Dom agreed on 2026-10-13 to use his own login until the tracker has an account
# of its own. Remove with: systemctl --user disable --now aethis-mcp-scan.timer
set -u
repo="$HOME/repos/aethis-mcp-scanner"
log="$HOME/.local/state/aethis-mcp-scan.log"
snapshots="$repo/data/snapshots/api.githubcopilot.com_mcp_"
node=$(ls -d "$HOME"/.nvm/versions/node/v2[2-9]*/bin/node 2>/dev/null | sort -V | tail -n 1)
stamp() { date -u +%Y-%m-%dT%H:%M:%SZ; }

cd "$repo" || { echo "$(stamp) failed: no repository at $repo" >> "$log"; exit 1; }
[ -x "$node" ] || { echo "$(stamp) failed: node not found" >> "$log"; exit 1; }

before=$(ls "$snapshots" 2>/dev/null | tail -n 1)
out=$(AETHIS_SCAN_GITHUB_TOKEN=$(gh auth token 2>/dev/null) "$node" src/cli.ts signed-in github --save 2>&1)
code=$?
# On failure the scanner prints one fixed sentence; it never prints the login or the server's text.
if [ "$code" -ne 0 ]; then echo "$(stamp) failed exit=$code: $(printf '%s' "$out" | tail -n 1)" >> "$log"; exit "$code"; fi

after=$(ls "$snapshots" | tail -n 1)
if [ -n "$before" ] && [ "$before" != "$after" ]; then
  echo "$(stamp) ok $after | $("$node" src/cli.ts diff "$snapshots/$before" "$snapshots/$after" | sed -n 2p)" >> "$log"
else
  echo "$(stamp) ok $after | nothing earlier to compare with" >> "$log"
fi
